{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for all windows (main + player windows)",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-fullscreen",
    "opener:default"
  ]
}
